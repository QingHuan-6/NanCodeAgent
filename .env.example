# Copy to .env and fill in values. Never commit real secrets.

# OpenAI-compatible API
NAN_API_KEY=
NAN_BASE_URL=https://api.openai.com/v1
NAN_MODEL=gpt-4o-mini

# Optional LLM tuning
# NAN_TEMPERATURE=0.2
# NAN_MAX_RETRIES=3
# NAN_TIMEOUT_MS=120000

# Workspace the agent may read/write (defaults to cwd)
# NAN_WORKSPACE=

# Agent loop limits
NAN_MAX_TURNS=40
