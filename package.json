{
  "name": "nan-code-agent",
  "version": "0.1.0",
  "description": "A minimal self-hosted coding agent harness (local tools + OpenAI-compatible tool calling)",
  "type": "module",
  "bin": {
    "nan-agent": "./dist/index.js"
  },
  "files": [
    "dist",
    "bundled-skills",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node --experimental-ffi dist/index.js",
    "dev": "node --experimental-ffi --import tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "link:global": "npm run build && npm link"
  },
  "engines": {
    "node": ">=26.4.0"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/node": "^22.13.10",
    "@types/react": "^19.2.18",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  },
  "dependencies": {
    "@opentui/core": "^0.5.9",
    "@opentui/react": "^0.5.9",
    "diff": "^9.0.0",
    "picocolors": "^1.1.1",
    "react": "^19.2.8",
    "react-devtools-core": "^7.0.1",
    "ws": "^8.21.3"
  }
}
